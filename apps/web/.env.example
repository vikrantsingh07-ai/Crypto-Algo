# ---- Vercel project environment variables (Settings → Environment Variables) ----
# Server-side only. Do NOT prefix with NEXT_PUBLIC_. Never put exchange API keys here.

# URL of your always-on backend (the Fly.io / Render / VPS service), e.g. https://cryptoalgo-api.fly.dev
BACKEND_URL=http://localhost:8080

# Optional but recommended: shared secret that the backend requires on every request
# (set the SAME value as PROXY_SHARED_SECRET on the backend). Generate: openssl rand -hex 32
PROXY_SHARED_SECRET=
