# ---- Vercel project environment variables (Project -> Settings -> Environment Variables) ----
# Set them for Production (tick Preview too if you use preview deployments), then REDEPLOY:
# Vercel reads them when a deployment is built, so a change only takes effect on the next deployment.
# Server-side only. Do NOT prefix with NEXT_PUBLIC_. Never put exchange API keys here.
# Vercel project settings (Root Directory = apps/web, Node.js version): docs/SUBAH_DEPLOY_HINGLISH.md.

# Public https URL of your always-on backend (Render / Railway / Fly / VPS): scheme included, NO trailing
# slash, NO /api suffix, e.g. https://cryptoalgo-server.onrender.com
# (this default is only for running the dashboard locally against `npm run dev:server`)
BACKEND_URL=http://localhost:8080

# Must be the SAME value as PROXY_SHARED_SECRET on the backend. On Render the Blueprint generates it:
# open the backend service -> Environment -> PROXY_SHARED_SECRET and copy it here exactly.
# If it is missing or different the backend answers 403 and the dashboard says "backend unreachable"
# or login fails. Generate your own with: openssl rand -hex 32
PROXY_SHARED_SECRET=
