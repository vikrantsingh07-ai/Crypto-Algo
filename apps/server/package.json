{
  "name": "@cryptoalgo/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API + always-on trading worker (single process, single active instance).",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/cli/migrate.ts",
    "hash-password": "tsx src/cli/hash-password.ts",
    "backtest": "tsx src/cli/backtest.ts"
  },
  "dependencies": {
    "@cryptoalgo/core": "*",
    "@cryptoalgo/delta": "*",
    "@electric-sql/pglite": "^0.5.10",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsup": "^9.0.0"
  }
}
