# ---- Mode ---------------------------------------------------------------
# PAPER = local simulated fills, public demo market data, no credentials needed
# DEMO  = real orders on the Delta India demo/testnet account (virtual funds)
# LIVE  = real money. Refused unless ALL live gates below are satisfied.
TRADING_MODE=DEMO
ENABLE_LIVE_TRADING=false
LIVE_CONFIRMATION=
ALLOW_ORDER_PLACEMENT=true

# ---- Credentials (separate per environment; never commit) ----------------
DELTA_DEMO_API_KEY=
DELTA_DEMO_API_SECRET=
DELTA_LIVE_API_KEY=
DELTA_LIVE_API_SECRET=

# ---- Instruments ----------------------------------------------------------
INITIAL_PREFERRED_DIRECTION=LONG
WATCHLIST=BTC,ETH
# PERPETUAL | OPTIONS | CONFIGURABLE (CONFIGURABLE = use EXPLICIT_SYMBOLS only)
MARKET_TYPE=PERPETUAL
# Optional deterministic override, e.g. BTCUSD or ETHUSD or C-BTC-90000-311225
EXPLICIT_SYMBOLS=
ALLOW_OTHER_CONTRACTS=false

# ---- Risk (INR) -------------------------------------------------------------
USD_INR_RATE=88.0
MAX_POSITION_NOTIONAL_INR=10
MAX_RISK_PER_TRADE_INR=2
RISK_REWARD_RATIO=2
RR_MODE=GROSS_RR            # GROSS_RR | NET_RR
MAX_DAILY_LOSS_INR=10
MAX_OPEN_POSITIONS=1
MAX_LEVERAGE=3
MAX_TRADES_PER_DAY=6
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_MINUTES=30
MAX_HOLD_MINUTES=480
DAILY_RESET_TZ=Asia/Kolkata

# ---- Strategy ---------------------------------------------------------------
TIMEFRAME=15m
TREND_TIMEFRAME=1h
EMA_FAST=9
EMA_SLOW=21
EMA_TREND=200
RSI_PERIOD=14
RSI_LONG_MIN=50
RSI_LONG_MAX=70
RSI_SHORT_MIN=30
RSI_SHORT_MAX=50
ATR_PERIOD=14
ATR_STOP_MULT=1.5
ALLOW_SHORT=false
MAX_SPREAD_PCT=0.1
MIN_VOLUME=0

# ---- Fees (leave blank to read from the product; blank+unavailable => ESTIMATED)
MAKER_FEE_RATE=
TAKER_FEE_RATE=
GST_RATE=0.18
SLIPPAGE_BPS=5

# ---- Operations --------------------------------------------------------------
TRADING_HOURS=24/7
LOG_LEVEL=INFO
LOOP_INTERVAL_SECONDS=15
STALE_DATA_SECONDS=90
DATA_DIR=./data
LOG_DIR=./logs
