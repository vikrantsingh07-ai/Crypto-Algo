# =====================================================================================
# CryptoAlgo BACKEND configuration (always-on server: API + trading worker)
# Local use: copy to .env.  Hosted: set these as environment variables / secrets on your host
# (Render, Railway, Fly, VPS). NEVER commit real values.
# The dashboard (Vercel) has its own, much smaller list: see apps/web/.env.example.
# Exchange API keys never go to Vercel.
# Phone / no-terminal deploy: docs/SUBAH_DEPLOY_HINGLISH.md (the Render Blueprint render.yaml asks
# only for DATABASE_URL and ADMIN_PASSWORD and generates the other secrets itself).
# An empty value means "not set".
# =====================================================================================

# production on a server; development (default) for local runs: it generates a throwaway admin
# password and allows weak/missing secrets. test is used by the automated tests.
NODE_ENV=production
HOST=0.0.0.0
# Hosts such as Render / Railway / Fly inject PORT themselves; do not set it there.
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info

# ---- Database -------------------------------------------------------------------------
# Managed PostgreSQL (Neon / Supabase / Render / Railway / RDS ...): ONE connection string that
# starts with postgresql:// (no psql, no quotes). Leave empty ONLY for local development: the server
# then uses an embedded database in DATA_DIR (single instance; in production it logs a warning).
DATABASE_URL=
# require | no-verify | disable. Leave empty when the connection string already ends with
# ?sslmode=require (Neon does). no-verify = encrypted but certificate not checked (use only if you get a
# certificate error). docker-compose sets "disable" for its own private database.
DATABASE_SSL=
# Folder of the embedded database (only used when DATABASE_URL is empty).
DATA_DIR=./data

# ---- Security (required in production) -------------------------------------------------
# Random string of at least 32 characters that signs dashboard sessions: openssl rand -hex 32
SESSION_SECRET=
# Hours a dashboard login lasts (0.25 - 168).
SESSION_TTL_HOURS=12
# Encrypts API keys saved from the dashboard (AES-256-GCM). Either base64 of 32 random bytes
# (openssl rand -base64 32) or ANY random secret of at least 32 characters, e.g. a 64-character hex
# string (openssl rand -hex 32) or a password-manager "random 40 characters" - those are stretched
# to 32 bytes with HKDF-SHA256. Keep the exact value: if it changes, saved API keys cannot be read
# any more (you would have to enter them again). If unset in production, keys can only be supplied
# through DELTA_API_KEY / DELTA_API_SECRET below.
CREDENTIAL_ENCRYPTION_KEY=
# Administrator login (can change settings, arm Live, use the kill switch). Set ONE of these:
#  - ADMIN_PASSWORD_HASH (recommended): bcrypt hash made with  npm run hash-password -- "long passphrase"
#    A hash contains "$" signs: in a .env file read by docker-compose wrap it in single quotes,
#    ADMIN_PASSWORD_HASH='$2b$12$...'. The server refuses a value that is not a bcrypt hash.
#  - ADMIN_PASSWORD (phone friendly): a plain password of at least 12 characters, hashed with bcrypt at
#    startup; the server logs a warning recommending the hash. Ignored when ADMIN_PASSWORD_HASH is set.
#    Outside production any length is accepted, and with neither set a random one is printed at startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
# Optional read-only account (bcrypt hash only)
VIEWER_USERNAME=viewer
VIEWER_PASSWORD_HASH=
# Shared secret the Vercel proxy must send on every request (the SAME value in Vercel's
# PROXY_SHARED_SECRET). Without it anyone who can reach this API URL can attempt logins.
PROXY_SHARED_SECRET=

# ---- Delta Exchange ---------------------------------------------------------------------
# production = Delta Exchange India (live data; REAL FUNDS once Live is armed)
# testnet = India demo account (no real funds)    global | global-testnet = Delta Global
# custom = use the URLs below.  Demo mode only reads PUBLIC market data and needs no API key.
# Keys are environment-specific: a testnet key does not work in production.
DELTA_ENV=production
# Only for DELTA_ENV=custom (or to override a host):
DELTA_REST_URL=
DELTA_WS_PUBLIC_URL=
DELTA_WS_PRIVATE_URL=
# Text shown in the dashboard instead of the built-in exchange name (e.g. for a local mock exchange).
DELTA_LABEL=
# Only for DELTA_ENV=custom: true = the endpoint trades real money (default), false = it does not.
DELTA_REAL_MONEY=
# Optional: provide API credentials through the host's secret manager instead of the dashboard.
# Create the key with TRADING permission only (never withdrawal) and whitelist this server's static IP.
DELTA_API_KEY=
DELTA_API_SECRET=
SYMBOL=ETHUSD

# ---- Behaviour --------------------------------------------------------------------------
# delta = real exchange data (default). synthetic = random development data; refused in production.
MARKET_DATA_SOURCE=delta
# true = Live activation is impossible on this deployment, whatever the dashboard says.
# false = the dashboard activation workflow may arm Live; it is OFF until an admin does that.
LIVE_HARD_DISABLE=false
# Start the (simulated) bot automatically on a fresh install.
BOT_AUTOSTART=true
# false on read-only API replicas. Exactly one instance may run the worker.
WORKER_ENABLED=true

# ---- Advanced / development only (not needed on a host) ----------------------------------
# Folder with the SQL migrations if the server cannot find them next to its files.
# MIGRATIONS_DIR=
# Speed multiplier of the synthetic feed (MARKET_DATA_SOURCE=synthetic, development).
# SYNTHETIC_SPEED=1
# npm run dev:mock (local fake exchange): port and whether it models the Scalper Offer exit-fee waiver.
# MOCK_PORT=9911
# MOCK_SCALPER_OFFER=true

# docker-compose only: password of the bundled Postgres container.
POSTGRES_PASSWORD=
