# =====================================================================================
# CryptoAlgo BACKEND configuration (always-on server: API + trading worker)
# Copy to .env for local use or set these as secrets on your host (Fly/Render/VPS).
# NEVER commit real values. The dashboard (Vercel) has its own, much smaller env file:
# see apps/web/.env.example. Exchange API keys never go to Vercel.
# =====================================================================================

# production on a server; use "development" for local runs (allows ADMIN_PASSWORD=..., generates a dev password)
NODE_ENV=production
PORT=8080

# ---- Database -------------------------------------------------------------------------
# Managed PostgreSQL (Supabase / Neon / Render / Railway / RDS ...). Leave empty ONLY for local
# development: the server then uses an embedded database in DATA_DIR (single instance, not for production).
DATABASE_URL=
# require | no-verify | disable  (managed providers normally need "require"; docker-compose uses "disable")
DATABASE_SSL=

# ---- Security (required in production) -------------------------------------------------
# Random string >= 32 chars used to sign dashboard sessions:  openssl rand -hex 32
SESSION_SECRET=
# 32 random bytes, base64: openssl rand -base64 32. Encrypts API keys saved from the dashboard (AES-256-GCM).
# If unset, keys can only be supplied through DELTA_API_KEY / DELTA_API_SECRET below.
CREDENTIAL_ENCRYPTION_KEY=
# Administrator login (can change settings, arm Live, use the kill switch). bcrypt hash of a long passphrase:
#   npm run hash-password -- "your long passphrase"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Optional read-only account
VIEWER_USERNAME=viewer
VIEWER_PASSWORD_HASH=
# Optional shared secret the Vercel proxy must send (set the SAME value in Vercel). openssl rand -hex 32
PROXY_SHARED_SECRET=

# ---- Delta Exchange ---------------------------------------------------------------------
# production = Delta Exchange India live (REAL FUNDS)      testnet = India demo account (no real funds)
# global | global-testnet = Delta Global           custom = use the URLs below
# Keys are environment-specific: a testnet key does not work in production.
DELTA_ENV=production
# Only for DELTA_ENV=custom (or to override a host):
DELTA_REST_URL=
DELTA_WS_PUBLIC_URL=
DELTA_WS_PRIVATE_URL=
# Optional: provide API credentials via the host's secret manager instead of the dashboard.
# Create the key with TRADING permission only, whitelist this server's static IP. (Delta keys have no withdrawal permission.)
DELTA_API_KEY=
DELTA_API_SECRET=
SYMBOL=ETHUSD

# ---- Behaviour --------------------------------------------------------------------------
# delta = real exchange data (default). "synthetic" = random development data; refused in production.
MARKET_DATA_SOURCE=delta
# true = Live activation is impossible on this deployment, whatever the dashboard says.
LIVE_HARD_DISABLE=false
# Start the (demo) bot automatically on a fresh install.
BOT_AUTOSTART=true
# false on read-only API replicas. Exactly one instance may run the worker.
WORKER_ENABLED=true
SESSION_TTL_HOURS=12
LOG_LEVEL=info

# docker-compose only
POSTGRES_PASSWORD=
